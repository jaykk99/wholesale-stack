# Copy to .env and fill in. The app runs fine with everything blank (local SQLite mode).

# Supabase (monico-agent project) - Postgres backend. Leave blank for local SQLite.
SUPABASE_URL=
SUPABASE_KEY=

# Your name/company, used to pre-fill contracts.
WHOLESALE_BUYER_NAME=
WHOLESALE_BUYER_COMPANY=

# US county module target, e.g. "Maricopa County, AZ". Leave blank to keep the stub inactive.
WHOLESALE_US_COUNTY=

# Autopilot (app/automation.py): scrape -> tag -> follow-ups -> Today task list.
# On by default; set AUTOMATION=0 to turn the built-in timer off.
AUTOMATION=1
AUTOMATION_INTERVAL_HOURS=6
# Shared secret for POST /cron/run (GitHub Actions / n8n wake-up ping). Any long random string.
CRON_SECRET=

# n8n basic auth (docker-compose only)
N8N_USER=admin
N8N_PASSWORD=changeme

# Optional: password-protect the whole CRM (HTTP Basic, any username). Blank = open.
APP_PASSWORD=
# Optional: report unhandled crashes to Error Inbox (needs an eibx_ owner key).
ERROR_INBOX_URL=
ERROR_INBOX_KEY=

# Crypto checkout (vendored paywatch, app/crypto_checkout.py)
# Plans: PAYWATCH_PLANS_JSON wins, else the repo file paywatch_plans.json
# (which ships PLACEHOLDER tiers only - set real prices there or here).
PAYWATCH_PLANS_JSON=
# Paywatch order + entitlement database file. Blank = paywatch.db in the repo root.
WHOLESALE_CRYPTO_DB=
# Owner manual-approve secret for POST /api/crypto/orders/{id}/approve.
# If set, approval requires it. If unset, the host gate (APP_PASSWORD) applies.
PAYWATCH_CRON_SECRET=
# Receive pools override the shipped default public receive addresses per asset.
# PAYWATCH_ADDRESSES={"btc":["..."],"eth":["..."],"bnb":["..."],"sol":["..."]}
PAYWATCH_ADDRESSES=
